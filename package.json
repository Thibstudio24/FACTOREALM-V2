{
  "name": "factorealm",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "bin": {
    "factorealm": "./bin/factorealm.mjs"
  },
  "scripts": {
    "dev": "tsx server.ts",
    "start": "tsx server.ts --production",
    "build": "vite build",
    "preview": "vite preview",
    "test": "tsx --test src/core/core.test.ts src/server/integration.test.ts installer/installer.test.ts",
    "install:server": "node installer/install.mjs",
    "package:deb": "bash installer/build-deb.sh",
    "clean": "node -e \"for (const p of ['dist','server.js']) require('node:fs').rmSync(p, { recursive: true, force: true })\"",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "pdf-lib": "^1.17.1",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "tsx": "^4.21.0",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2"
  }
}
